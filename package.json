{
  "name": "bunny.plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs",
    "deploy": "pnpm build:client && wrangler deploy --config wrangler.jsonc",
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.dev.vars --import tsx server/index.ts\" \"vite\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "test": "node --import tsx --test server/cache.test.ts worker/session.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.20.0",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@10.28.1"
}

ENABLE_DEV_AUTH=true
DEV_USER_JSON={"id":"local-dev","name":"Local Bunny","admin":true,"avatar":null,"permissions":["admin","stream.manage","chloe.chat"]}
ADMIN_DISCORD_IDS=
APP_URL=http://localhost:5173
